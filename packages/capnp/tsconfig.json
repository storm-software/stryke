{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "types": [
      "node",
      "capnp-es",
      "./types/nanotar.d.ts"
    ],
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmitOnError": false,
    "outDir": "../../dist/out-tsc",
    "preserveConstEnums": true,
    "removeComments": false,
    "verbatimModuleSyntax": false,
    "skipDefaultLibCheck": false,
    "skipLibCheck": false,
    "ignoreDeprecations": "6.0",
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "types/**/*"
  ],
  "exclude": [
    "vitest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "composite": true,
  "references": [
    {
      "path": "../../tools/config"
    },
    {
      "path": "../convert"
    },
    {
      "path": "../fs"
    },
    {
      "path": "../path"
    },
    {
      "path": "../types"
    }
  ]
}
